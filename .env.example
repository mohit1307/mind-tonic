# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/mind-tonic

# JWT
JWT_SECRET=your-secret-key-min-32-chars-change-this
JWT_REFRESH_SECRET=your-refresh-secret-key-min-32-chars-change-this
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# AI / LLM
LLM_PROVIDER=gemini
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AIza...

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# File Uploads
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads
